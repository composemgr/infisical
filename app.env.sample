# Infisical app.env.sample
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=myhostname

# Encryption / auth secrets (must be at least 32 chars)
ENCRYPTION_KEY=changeme_secret_key_min_32_chars
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Database credentials
DB_USER_NAME=infisical
DB_USER_PASS=changeme_db_password
DB_CREATE_DATABASE_NAME=infisical
